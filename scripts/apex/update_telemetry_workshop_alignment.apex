// Comprehensive Update Script to Align Telemetry 360 Workshop with README Content
// This script updates Workshop_Step__c instructions and Workshop_Step_Detail__c records to match the official README

System.debug('🚀 Starting comprehensive alignment of Telemetry 360 Workshop with README content');

// Get the workshop ID
String workshopId = 'a01Ka00000T4v4zIAB';

// First, let's update the Workshop_Step__c instructions to match README exactly
List<Workshop_Step__c> stepsToUpdate = [
    SELECT Id, Name, Step_Order__c, Instructions__c 
    FROM Workshop_Step__c 
    WHERE Workshop__c = :workshopId 
    ORDER BY Step_Order__c
];

System.debug('📝 Found ' + stepsToUpdate.size() + ' workshop steps to update');

// Update each step's instructions based on README content
for (Workshop_Step__c step : stepsToUpdate) {
    String stepName = step.Name;
    
    if (stepName == 'Review and Enable Setup Requirements') {
        step.Instructions__c = '<p><strong>Review and Enable Setup Requirements</strong></p>' +
            '<p>Before we start building our connected asset solutions, let\'s verify that all required services are properly configured and enabled in your Salesforce org.</p>' +
            '<p><strong>Important:</strong> These setup requirements must be completed before proceeding with the workshop. This ensures all participants have the necessary foundation to successfully complete the hands-on exercises.</p>';
            
    } else if (stepName == 'Cloning an existing definition') {
        step.Instructions__c = '<p><strong>Cloning an existing definition</strong></p>' +
            '<p>Get off to a fast start by cloning an Out of the Box context definition.</p>' +
            '<p>This process involves navigating to Context Definitions, selecting the VehicleFaultEventDetail definition, cloning it, and giving it a new name that reflects our asset-focused approach.</p>';
            
    } else if (stepName == 'Context Service Customization') {
        step.Instructions__c = '<p><strong>Context Service Customization</strong></p>' +
            '<p>Configure the new context definition for Assets. Edit the cloned Context Definition to align to connected asset event stream.</p>' +
            '<p>This step involves accessing your custom definitions, modifying attributes, and adding new nodes to support asset-based telemetry data.</p>';
            
    } else if (stepName == 'Context Definition Attributes') {
        step.Instructions__c = '<p><strong>Context Definition Attributes</strong></p>' +
            '<p>Attributes are fields on a node that can be mapped to sObjects or any input data source. Rename attributes from vehicle-focused to asset-focused.</p>' +
            '<p>You\'ll update attribute names and create new threshold attributes to support asset monitoring.</p>';
            
    } else if (stepName == 'Context Definition Tagging') {
        step.Instructions__c = '<p><strong>Context Definition Tagging</strong></p>' +
            '<p>Tags are used to define the context structure and point to a node or attribute so the consuming application can query data directly from the context definition.</p>' +
            '<p>This step involves adding asset tags, removing vehicle tags, and tagging the thresholds node.</p>';
            
    } else if (stepName == 'Context Definition Mapping') {
        step.Instructions__c = '<p><strong>Context Definition Mapping</strong></p>' +
            '<p>Context Mapping is the mapping of nodes and attributes to an input data source. Replace Vehicle mappings with Asset object mappings.</p>' +
            '<p>This comprehensive process includes mapping data sources, replacing Vehicle object with Asset object, configuring field mappings, and activating the definition.</p>';
            
    } else if (stepName == 'Actionable Event Management') {
        step.Instructions__c = '<p><strong>Actionable Event Management</strong></p>' +
            '<p>Define the actions to be performed for actionable events generated by assets by creating actionable event orchestrations.</p>' +
            '<p>You\'ll create qualification and evaluation rules for different types of actionable events that are generated in assets.</p>';
            
    } else if (stepName == 'Execution Procedures and Expression Sets') {
        step.Instructions__c = '<p><strong>Execution Procedures and Expression Sets</strong></p>' +
            '<p>Pull variables from the event stream and CRM to define rules and actions. Create list group filters with OR conditions for lower/upper thresholds.</p>' +
            '<p>This involves creating comprehensive logic for threshold monitoring, alert generation, and automated responses.</p>';
            
    } else if (stepName == 'Testing with Developer Console') {
        step.Instructions__c = '<p><strong>Testing with Developer Console</strong></p>' +
            '<p>Time to test and see if all the hard work pays off. Navigate to Manufacturing Service Console to get an AssetId and test the complete workflow.</p>' +
            '<p>You\'ll access the Manufacturing Service Console, select an asset record, copy the Asset ID, and execute test payloads to verify the end-to-end functionality.</p>';
    }
}

// Update the workshop steps
try {
    update stepsToUpdate;
    System.debug('✅ Successfully updated ' + stepsToUpdate.size() + ' workshop step instructions');
} catch (Exception e) {
    System.debug('❌ Error updating workshop steps: ' + e.getMessage());
}

// Now, let's delete existing Workshop_Step_Detail__c records and create new ones that match README exactly
List<Workshop_Step_Detail__c> existingDetails = [
    SELECT Id 
    FROM Workshop_Step_Detail__c 
    WHERE Workshop_Step__r.Workshop__c = :workshopId
];

System.debug('🗑️ Deleting ' + existingDetails.size() + ' existing step details');

try {
    delete existingDetails;
    System.debug('✅ Successfully deleted existing step details');
} catch (Exception e) {
    System.debug('❌ Error deleting existing step details: ' + e.getMessage());
}

// Create new Workshop_Step_Detail__c records that match README structure exactly
List<Workshop_Step_Detail__c> newDetails = new List<Workshop_Step_Detail__c>();

// Get Workshop_Step__c records with their IDs
Map<String, Id> stepNameToId = new Map<String, Id>();
for (Workshop_Step__c step : stepsToUpdate) {
    stepNameToId.put(step.Name, step.Id);
}

